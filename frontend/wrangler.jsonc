// Cloudflare Workers config: hosts the Vite build as static assets (no Worker script).
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker name — also reachable at https://board-games-community.racicvladan97.workers.dev
  "name": "board-games-community",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    // Unknown paths return index.html so React Router can handle them.
    "not_found_handling": "single-page-application"
  },
  // Production domain. Kept here so every deploy keeps it attached to this Worker.
  "routes": [
    { "pattern": "board-games-community.com", "custom_domain": true }
  ],
  // workers.dev stays on: PR preview URLs are served from it.
  "workers_dev": true,
  "preview_urls": true
}
