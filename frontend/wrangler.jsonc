// Cloudflare Workers config: hosts the Vite build as static assets (no Worker script).
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker name — default URL: https://board-games-community.<your-subdomain>.workers.dev
  "name": "board-games-community",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    // Unknown paths return index.html so React Router can handle them.
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": true
}
